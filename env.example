# Environment Variables for Traffic Violation Detection API
# Copy this file to .env and update the values

# Gmail SMTP Configuration (Optional - for email notifications)
GMAIL_USERNAME=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_FROM=your_email@gmail.com

# Database Configuration
DATABASE_URL=sqlite:///./traffic_violations.db
# For PostgreSQL (production): postgresql://username:password@hostname:port/database_name

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Traffic Violation Detection API

# CORS Settings
ALLOWED_ORIGINS=["*"]
# For production, specify exact origins: ["https://yourdomain.com", "https://admin.yourdomain.com"]

# File Upload Settings
UPLOAD_DIR=uploads
EVIDENCE_DIR=evidence
MAX_FILE_SIZE=524288000
ALLOWED_VIDEO_TYPES=["video/mp4", "video/avi", "video/mov", "video/mkv"]

# Model Settings
MODEL_SIZE=small
YOLO_MODEL_PATH=models/yolov8s.pt
SVM_MODEL_PATH=models/svm_model.pkl
PCA_MODEL_PATH=models/pca.pkl

# Redis Settings
REDIS_URL=redis://localhost:6379
# For Redis Cloud (production): redis://username:password@hostname:port

# Processing Settings
DEFAULT_CONFIDENCE_THRESHOLD=0.5
DEFAULT_IOU_THRESHOLD=0.45
MIN_MOTORCYCLE_AREA=3000
HELMET_CHECK_CONFIDENCE=0.6

# Traffic Direction Settings
DEFAULT_TRAFFIC_DIRECTION=right

# WebSocket Settings
WEBSOCKET_HEARTBEAT_INTERVAL=30

# Render Deployment Notes:
# - PORT is automatically set by Render
# - Use PostgreSQL database URL from Render dashboard
# - Use Redis URL from Render Redis service
# - Set UPLOAD_DIR and EVIDENCE_DIR to /tmp/uploads and /tmp/evidence respectively
